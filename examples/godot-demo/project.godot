; Godot 4 project — Pixel Pipeline asset-validation demo.
; Engine-authored keys (uid, etc.) are added automatically on first open.

config_version=5

[application]

config/name="Pixel Pipeline — Asset Validation Demo"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.2")

[display]

window/size/viewport_width=1152
window/size/viewport_height=648

[rendering]

textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.11, 0.12, 0.16, 1)
